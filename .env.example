# Copy to .env and fill locally. Never commit .env.
# Exchange keys must have Query + Trade only. Withdraw must be disabled.

AETHER_ENV=paper
VENUE=kraken
SYMBOL=BTC/USD

# Leave empty until sandbox keys are issued.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

DATABASE_URL=postgresql+asyncpg://aether:aether@postgres:5432/aether
REDIS_URL=redis://redis:6379/0

# Optional durable paper ledger. Before enabling, run:
#   cd backend && alembic upgrade head
AETHER_PERSISTENCE_ENABLED=false

OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change-me
OPERATOR_AUTH_SECRET=replace-with-long-random-string

API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE=http://localhost:8000
