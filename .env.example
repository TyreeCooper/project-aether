# Copy to .env and fill locally. Never commit .env.
# Exchange keys must have Query + Trade only. Withdraw must be disabled.

AETHER_ENV=paper
VENUE=kraken
SYMBOL=BTC/USD
MARKET_DATA_PROVIDER=kraken_ws

# Dedicated read-only Kraken Spot key for account-readiness checks.
# Recommended permissions: Query Funds only. Withdraw must stay disabled.
KRAKEN_READ_API_KEY=
KRAKEN_READ_API_SECRET=
VENUE_RECONCILIATION_REQUIRED=false
VENUE_RECONCILIATION_MAX_AGE_SECONDS=60

# Leave trading credentials empty until a later promotion stage.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

DATABASE_URL=postgresql+asyncpg://aether:aether@postgres:5432/aether
REDIS_URL=redis://redis:6379/0

# Optional durable paper ledger. Before enabling, run:
#   cd backend && alembic upgrade head
AETHER_PERSISTENCE_ENABLED=false

OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change-me
OPERATOR_AUTH_SECRET=replace-with-long-random-string
OPERATOR_STEP_UP_SECRET=replace-with-a-different-long-random-string

API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_BASE=http://localhost:8000
